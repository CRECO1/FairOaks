# App
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
NODE_ENV=development

# Database (Supabase)
# IMPORTANT: Payload CMS uses Drizzle ORM which requires prepared statements.
# Transaction mode (port 6543) does NOT support prepared statements.
# You MUST use Session Pooler mode (port 5432) which DOES support prepared statements.
#
# Get connection string from: Supabase Dashboard > Project Settings > Connect > Session Pooler
# Format: postgresql://postgres.[PROJECT-REF]:[URL-ENCODED-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
#
# Password URL encoding: @ -> %40, $ -> %24, # -> %23, etc.
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Payload CMS
# Generate a strong secret: openssl rand -base64 32
PAYLOAD_SECRET=

# Vercel Blob Storage
BLOB_READ_WRITE_TOKEN=

# Email (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxxx
LEAD_NOTIFICATION_EMAIL=leads@crecotx.com

# reCAPTCHA v3
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# SABOR RESO Web API (San Antonio Board of Realtors IDX)
# Auth:    https://sabor-auth.connectmls.com/authenticate/signin
# API:     https://api-sabor.connectmls.com/reso/webapi/
SABOR_RESO_USERNAME=reso_creco
SABOR_RESO_PASSWORD=

# Scope the sync to your office or agent — leave both blank to sync all Active/Pending
# Use one or the other (AGENT_EMAIL takes precedence)
SABOR_AGENT_EMAIL=
SABOR_OFFICE_KEY=

# Advanced: override the entire OData $filter for the sync (optional)
# e.g. "StandardStatus eq 'Active' and City eq 'San Antonio'"
SABOR_MLS_FILTER=

# CRM Webhook (optional)
CRM_WEBHOOK_URL=

# Webhook auth secret (used as Bearer token — generate with: openssl rand -hex 32)
WEBHOOK_SECRET=

# Cron job auth secret (set same value in Vercel cron config — generate with: openssl rand -hex 32)
CRON_SECRET=

# Upstash KV (rate limiting — provision in Vercel dashboard or upstash.com)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ATTOM Data API (property intel / comps)
# Sign up at https://www.attomdata.com/solutions/property-data-api/ (30-day free trial)
ATTOM_API_KEY=

# Google Business Profile
# Get your review link: Google Business Profile dashboard → Get more reviews → copy the link
GOOGLE_REVIEW_URL=https://g.page/r/YOUR_PLACE_ID/review

# Analytics
NEXT_PUBLIC_GA_ID=
